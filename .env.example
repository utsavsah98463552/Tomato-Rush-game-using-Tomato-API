# Copy to .env and run with:  node --env-file=.env server/server.js
PORT=3000
# Long random string used to sign login tokens. REQUIRED when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-string
# Tomato API endpoint (default shown)
TOMATO_API_URL=https://marcconrad.com/uob/tomato/api.php?out=json&base64=yes
# Where user accounts and scores are saved
# DATA_FILE=./data/db.json
